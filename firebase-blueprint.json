{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil privado do usuário autenticado e preferências do painel.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "activeVehicleId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "createdAt", "updatedAt"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Veículo cadastrado pelo usuário para rastreamento isolado de abastecimentos.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "brand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "year": {
          "type": "integer"
        },
        "defaultFuel": {
          "type": "string",
          "enum": ["Gasolina", "Etanol", "Diesel", "GNV"]
        },
        "currentOdometer": {
          "type": "number"
        },
        "tankCapacity": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "name",
        "brand",
        "year",
        "defaultFuel",
        "currentOdometer",
        "createdAt",
        "updatedAt"
      ]
    },
    "Refueling": {
      "title": "Refueling",
      "description": "Registro de abastecimento vinculado a um veículo do usuário.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "vehicleId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "odometerKm": {
          "type": "number"
        },
        "totalPaid": {
          "type": "number"
        },
        "liters": {
          "type": "number"
        },
        "pricePerLiter": {
          "type": "number"
        },
        "fuelType": {
          "type": "string",
          "enum": ["Gasolina", "Etanol", "Diesel", "GNV"]
        },
        "fullTank": {
          "type": "boolean"
        },
        "station": {
          "type": "string",
          "maxLength": 100
        },
        "notes": {
          "type": "string",
          "maxLength": 400
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "vehicleId",
        "date",
        "odometerKm",
        "totalPaid",
        "liters",
        "pricePerLiter",
        "fuelType",
        "fullTank",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Documento privado do perfil do usuário e veículo ativo selecionado."
    },
    "/users/{userId}/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/Vehicle" },
      "description": "Subcoleção de veículos pertencentes exclusivamente ao usuário."
    },
    "/users/{userId}/refuelings/{refuelingId}": {
      "schema": { "$ref": "#/entities/Refueling" },
      "description": "Subcoleção de abastecimentos do usuário vinculados a um veículo existente."
    }
  }
}
